@{
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string On(string a) => string.Equals(action, a, StringComparison.OrdinalIgnoreCase) ? "on" : "";
}
<nav class="report-tabs mb-3" aria-label="@L["Reports"]">
    <a asp-action="Udhaar" class="@On("Udhaar")"><i class="bi bi-hourglass-split"></i>@L["Udhaar list"]</a>
    <a asp-action="Bottles" class="@On("Bottles")"><i class="bi bi-droplet"></i>@L["Bottles"]</a>
    <a asp-action="Sales" class="@On("Sales")"><i class="bi bi-graph-up-arrow"></i>@L["Sales"]</a>
</nav>
