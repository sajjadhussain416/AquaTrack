@model AquaTrack.Application.Expenses.ExpenseMonth
@{
    ViewData["Title"] = L["Expenses"];
    var p = Model.Period;
    var current = (BillPeriod)ViewBag.Current;
    var category = ViewBag.Category as ExpenseCategory?;
    var today = (DateOnly)ViewBag.Today;
    var canGoNext = p.Next.Start <= current.Start;
    var isCurrent = p.Start == current.Start;
    var defaultDate = isCurrent ? today : p.NextStart.AddDays(-1);
    var max = Model.ByCategory.Count == 0 ? 1m : Model.ByCategory.Max(c => c.Amount);
    string Pct(decimal v) => (v * 100m / max).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "%";
}

<div class="page-head">
    <div>
        <h1>@L["Expenses"]</h1>
        <p>@L["Money spent on running the plant. It is taken out of sales in the profit report."]</p>
    </div>
    <div class="actions">
        <a asp-controller="Reports" asp-action="Profit" class="btn btn-light btn-icon"><i class="bi bi-graph-up"></i>@L["Profit report"]</a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header"><i class="bi bi-plus-circle me-2 text-primary"></i>@L["Add expense"]</div>
            <form asp-action="Add" method="post" class="card-body d-grid gap-3" data-once>
                <div class="expense-cats" role="radiogroup" aria-label="@L["Category"]">
                    @foreach (var c in Enum.GetValues<ExpenseCategory>())
                    {
                        <label class="method-pick">
                            <input type="radio" name="Category" value="@c" checked="@(c == ExpenseCategory.Electricity)" />
                            <i class="bi @EnumText.Icon(c)"></i><span>@L[EnumText.Of(c)]</span>
                        </label>
                    }
                </div>
                <div class="row g-2">
                    <div class="col-6">
                        <label class="form-label small" for="Amount">@L["Amount (PKR)"]</label>
                        <input id="Amount" name="Amount" type="number" min="1" step="1" required class="form-control num" style="height:46px;font-weight:700" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small" for="Date">@L["Date"]</label>
                        <input id="Date" name="Date" type="date" required class="form-control num" style="height:46px" value="@Fmt.Iso(defaultDate)" max="@Fmt.Iso(today)" />
                    </div>
                    <div class="col-12">
                        <label class="form-label small" for="Note">@L["Note (optional)"]</label>
                        <input id="Note" name="Note" maxlength="300" class="form-control" placeholder="@L["e.g. WAPDA bill October, 2 filter cartridges"]" />
                    </div>
                </div>
                <button class="btn btn-primary btn-icon justify-content-center"><i class="bi bi-check2"></i>@L["Save expense"]</button>
            </form>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-body d-flex flex-wrap align-items-center gap-3 border-bottom">
                <div class="month-nav">
                    <a asp-route-year="@p.Previous.Year" asp-route-month="@p.Previous.Month" class="btn btn-light" aria-label="@L["Previous"]">
                        <i class="bi @(AppCultures.IsUrdu ? "bi-chevron-right" : "bi-chevron-left")"></i>
                    </a>
                    <span class="month-label">@Fmt.Month(p)</span>
                    @if (canGoNext)
                    {
                        <a asp-route-year="@p.Next.Year" asp-route-month="@p.Next.Month" class="btn btn-light" aria-label="@L["Next"]">
                            <i class="bi @(AppCultures.IsUrdu ? "bi-chevron-left" : "bi-chevron-right")"></i>
                        </a>
                    }
                </div>
                <div class="ms-auto text-end">
                    <div class="stat-label">@L["Spent in {0}", Fmt.Month(p)]</div>
                    <div class="stat-value num text-danger">@Fmt.Money(Model.Total)</div>
                </div>
            </div>
            <div class="card-body">
                @if (Model.ByCategory.Count == 0)
                {
                    <p class="text-muted small mb-0">@L["No expenses in {0}.", Fmt.Month(p)]</p>
                }
                else
                {
                    <div class="d-grid gap-2">
                        @foreach (var c in Model.ByCategory)
                        {
                            <a class="cat-line @(category == c.Category ? "on" : "")" asp-route-year="@p.Year" asp-route-month="@p.Month" asp-route-category="@(category == c.Category ? (ExpenseCategory?)null : c.Category)">
                                <span class="cat-name"><i class="bi @EnumText.Icon(c.Category)"></i>@L[EnumText.Of(c.Category)]</span>
                                <span class="day-bar flex-fill"><span style="width:@Pct(c.Amount)"></span></span>
                                <span class="num fw-bold">@Fmt.Money(c.Amount)</span>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="card">
    @if (Model.Rows.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-wallet2"></i>
            <h5 class="text-body">@L["No expenses yet"]</h5>
            <p class="mb-0">@L["Add electricity, filters, salary and other costs to see your real profit."]</p>
        </div>
    }
    else
    {
        @if (category is not null)
        {
            <div class="card-body border-bottom py-2 small">
                @L["Showing: {0}", L[EnumText.Of(category.Value)]]
                <a asp-route-year="@p.Year" asp-route-month="@p.Month" class="ms-2">@L["Show all"]</a>
            </div>
        }
        <div class="table-responsive">
            <table class="table table-at mb-0">
                <thead>
                    <tr>
                        <th>@L["Date"]</th>
                        <th>@L["Category"]</th>
                        <th>@L["Note"]</th>
                        <th class="text-end">@L["Amount"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var e in Model.Rows)
                {
                    <tr>
                        <td class="num">@Fmt.Day(e.Date)</td>
                        <td><i class="bi @EnumText.Icon(e.Category) me-1 text-muted"></i>@L[EnumText.Of(e.Category)]</td>
                        <td class="text-muted">@e.Note</td>
                        <td class="text-end num fw-bold">@Fmt.Money(e.Amount)</td>
                        <td class="text-end">
                            <form asp-action="Delete" asp-route-id="@e.Id" asp-route-year="@p.Year" asp-route-month="@p.Month" method="post" class="d-inline" onsubmit="return confirm('@L["Remove this entry?"]');">
                                <button class="btn btn-light btn-sm text-danger" aria-label="@L["Remove"]"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="3">@L["Total"]</th>
                        <th class="text-end num">@Fmt.Money(Model.Rows.Sum(e => e.Amount))</th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
</div>
