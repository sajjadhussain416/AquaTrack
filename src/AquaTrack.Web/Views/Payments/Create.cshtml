@model PaymentFormViewModel
@{
    ViewData["Title"] = L["Receive payment"];
}

<div class="page-head">
    <div>
        <a asp-action="Index" class="small fw-semibold text-decoration-none">
            <i class="bi @(AppCultures.IsUrdu ? "bi-arrow-right" : "bi-arrow-left")"></i> @L["Payments"]
        </a>
        <h1 class="mt-1">@L["Receive payment"]</h1>
        <p>@L["For money paid at the plant. Cash taken at the door is entered on the delivery screen."]</p>
    </div>
</div>

<form asp-action="Create" method="post" data-once novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger flash validation-summary" role="alert"></div>
    <div class="row g-3">
        <div class="col-lg-7">
            <div class="card">
                <div class="card-body d-grid gap-3">
                    <div>
                        <label asp-for="CustomerId" class="form-label"></label>
                        <select asp-for="CustomerId" class="form-select" id="customerPick">
                            <option value="0">@L["Select customer"]</option>
                            @foreach (var c in Model.Customers)
                            {
                                <option value="@c.Id" data-balance="@c.Balance.ToString(System.Globalization.CultureInfo.InvariantCulture)">@c.Name · @c.AreaName · @c.Phone</option>
                            }
                        </select>
                        <span asp-validation-for="CustomerId"></span>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Amount" class="form-label"></label>
                            <input asp-for="Amount" type="number" min="1" step="1" class="form-control num" style="height:48px;font-size:1.15rem;font-weight:700" />
                            <span asp-validation-for="Amount"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Date" class="form-label"></label>
                            <input asp-for="Date" type="date" class="form-control num" style="height:48px" value="@Fmt.Iso(Model.Date)" max="@Fmt.Iso(Model.Today)" />
                        </div>
                    </div>
                    <div>
                        <label class="form-label">@L["Payment method"]</label>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var pm in Enum.GetValues<PaymentMethod>())
                            {
                                <label class="pick">
                                    <input type="radio" class="form-check-input mt-0" name="Method" value="@pm" checked="@(Model.Method == pm)" />
                                    <i class="bi @EnumText.Icon(pm)"></i><span>@L[EnumText.Of(pm)]</span>
                                </label>
                            }
                        </div>
                    </div>
                    <div>
                        <label asp-for="Note" class="form-label"></label>
                        <input asp-for="Note" class="form-control" placeholder="@L["e.g. JazzCash transaction ID"]" />
                        <span asp-validation-for="Note"></span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card mb-3">
                <div class="card-body">
                    <div class="stat-label">@L["Balance due"]</div>
                    <div class="stat-value num" id="balanceDue">-</div>
                    <button type="button" class="btn btn-light btn-sm mt-2" id="payFull" hidden>@L["Pay full balance"]</button>
                </div>
            </div>
            <button type="submit" class="btn btn-primary w-100 btn-lg-at btn-icon justify-content-center">
                <i class="bi bi-check2"></i><span>@L["Save payment"]</span>
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        (function () {
            var pick = document.getElementById('customerPick'), due = document.getElementById('balanceDue'),
                full = document.getElementById('payFull'), amount = document.getElementById('Amount');
            function show() {
                var opt = pick.options[pick.selectedIndex];
                var b = parseFloat(opt && opt.getAttribute('data-balance'));
                if (isNaN(b)) { due.textContent = '-'; full.hidden = true; return; }
                due.textContent = (b < 0 ? '-' : '') + 'Rs ' + Math.abs(b).toLocaleString('en-US');
                due.className = 'stat-value num ' + (b > 0 ? 'text-danger' : 'text-success');
                full.hidden = !(b > 0);
                full.onclick = function () { amount.value = Math.round(b); };
            }
            pick.addEventListener('change', show); show();
        })();
    </script>
}
