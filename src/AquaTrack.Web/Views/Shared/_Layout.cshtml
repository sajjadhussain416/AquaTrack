@{
    var fullName = User.FindFirst(AppClaims.FullName)?.Value ?? User.Identity?.Name ?? "";
    var initial = string.IsNullOrEmpty(fullName) ? "A" : fullName[..1].ToUpperInvariant();
    var roleLabel = User.IsInRole(Roles.SuperAdmin) ? L["Super Admin"]
        : User.IsInRole(Roles.PlantOwner) ? L["Plant owner"]
        : User.IsInRole(Roles.PlantManager) ? L["Plant manager"]
        : L["Delivery staff"];
}
<!DOCTYPE html>
<html lang="@(AppCultures.IsUrdu ? "ur" : "en")" dir="@AppCultures.Direction">
<head>
    <partial name="_Head" />
    <title>@ViewData["Title"] · AquaTrack</title>
</head>
<body>
    <div class="app">
        <partial name="_Sidebar" />

        <div class="main">
            <header class="topbar">
                <button class="menu-toggle" type="button" data-sidebar-open aria-label="@L["Menu"]">
                    <i class="bi bi-list"></i>
                </button>
                <h2 class="page-title">@ViewData["Title"]</h2>

                <div class="topbar-actions">
                    <partial name="_LanguageSwitch" />

                    <div class="dropdown">
                        <button class="user-chip" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="avatar">@initial</span>
                            <span class="who">
                                <strong>@fullName</strong>
                                <small>@roleLabel</small>
                            </span>
                            <i class="bi bi-chevron-down small text-muted"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            <li class="dropdown-item-text small text-muted num">@User.Identity?.Name</li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item text-danger">
                                        <i class="bi bi-box-arrow-right me-2"></i>@L["Sign out"]
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <main class="content">
                @await Component.InvokeAsync("SubscriptionBanner")
                <partial name="_Flash" />
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
