@{
    var area = ViewContext.RouteData.Values["area"]?.ToString() ?? "";
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Active(string a, string c) =>
        string.Equals(area, a, StringComparison.OrdinalIgnoreCase) &&
        string.Equals(controller, c, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string ActiveAction(string a) =>
        Active("", "Reports") == "active" && string.Equals(action, a, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<aside class="sidebar" id="sidebar">
    <a class="brand" href="~/">
        <span class="brand-mark"><i class="bi bi-droplet-fill"></i></span>
        <span>
            <span class="brand-name">AquaTrack</span>
            <span class="brand-tag">@L["Water delivery made simple"]</span>
        </span>
    </a>

    <nav class="nav-group">
        @if (User.IsInRole(Roles.SuperAdmin))
        {
            <div class="nav-group-title">@L["Platform"]</div>
            <a class="side-link @Active("SuperAdmin", "Dashboard")" asp-area="SuperAdmin" asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-grid-1x2"></i><span>@L["Dashboard"]</span>
            </a>
            <a class="side-link @Active("SuperAdmin", "Plants")" asp-area="SuperAdmin" asp-controller="Plants" asp-action="Index">
                <i class="bi bi-buildings"></i><span>@L["Water plants"]</span>
            </a>
            <a class="side-link @Active("SuperAdmin", "Subscriptions")" asp-area="SuperAdmin" asp-controller="Subscriptions" asp-action="Index">
                <i class="bi bi-credit-card-2-front"></i><span>@L["Subscriptions"]</span>
            </a>
            <a class="side-link @Active("SuperAdmin", "Plans")" asp-area="SuperAdmin" asp-controller="Plans" asp-action="Index">
                <i class="bi bi-layers"></i><span>@L["Plans"]</span>
            </a>
        }
        else if (User.IsInRole(Roles.DeliveryBoy))
        {
            <div class="nav-group-title">@L["My work"]</div>
            <a class="side-link @Active("", "Delivery")" asp-area="" asp-controller="Delivery" asp-action="Index">
                <i class="bi bi-truck"></i><span>@L["Today's deliveries"]</span>
            </a>
        }
        else
        {
            <div class="nav-group-title">@L["Plant"]</div>
            <a class="side-link @Active("", "Dashboard")" asp-area="" asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-grid-1x2"></i><span>@L["Dashboard"]</span>
            </a>
            <a class="side-link @Active("", "Customers")" asp-area="" asp-controller="Customers" asp-action="Index"><i class="bi bi-people"></i><span>@L["Customers"]</span></a>
            <a class="side-link @(Active("", "Deliveries") + Active("", "Delivery"))" asp-area="" asp-controller="Deliveries" asp-action="Index"><i class="bi bi-truck"></i><span>@L["Deliveries"]</span></a>
            <a class="side-link @Active("", "Bills")" asp-area="" asp-controller="Bills" asp-action="Index"><i class="bi bi-receipt"></i><span>@L["Bills"]</span></a>
            <a class="side-link @Active("", "Payments")" asp-area="" asp-controller="Payments" asp-action="Index"><i class="bi bi-cash-coin"></i><span>@L["Payments"]</span></a>
            <a class="side-link @Active("", "Cash")" asp-area="" asp-controller="Cash" asp-action="Index"><i class="bi bi-wallet2"></i><span>@L["Cash sheet"]</span></a>

            <div class="nav-group-title mt-2">@L["Reports"]</div>
            <a class="side-link @(ActiveAction("Udhaar"))" asp-area="" asp-controller="Reports" asp-action="Udhaar"><i class="bi bi-hourglass-split"></i><span>@L["Udhaar list"]</span></a>
            <a class="side-link @(ActiveAction("Bottles"))" asp-area="" asp-controller="Reports" asp-action="Bottles"><i class="bi bi-droplet"></i><span>@L["Bottle report"]</span></a>
            <a class="side-link @(ActiveAction("Sales"))" asp-area="" asp-controller="Reports" asp-action="Sales"><i class="bi bi-graph-up-arrow"></i><span>@L["Sales report"]</span></a>

            <div class="nav-group-title mt-2">@L["Setup"]</div>
            <a class="side-link @Active("", "DeliveryAreas")" asp-area="" asp-controller="DeliveryAreas" asp-action="Index"><i class="bi bi-geo-alt"></i><span>@L["Areas"]</span></a>
            <a class="side-link @Active("", "Staff")" asp-area="" asp-controller="Staff" asp-action="Index"><i class="bi bi-person-badge"></i><span>@L["Delivery staff"]</span></a>
            @if (User.IsInRole(Roles.PlantOwner))
            {
                <a class="side-link @Active("", "Settings")" asp-area="" asp-controller="Settings" asp-action="Index"><i class="bi bi-gear"></i><span>@L["Settings"]</span></a>
            }
        }
    </nav>

    <div class="sidebar-foot">AquaTrack v0.8</div>
</aside>
<div class="sidebar-backdrop" data-sidebar-close></div>
