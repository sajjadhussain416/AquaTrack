@{
    Layout = "_AuthLayout";
    ViewData["Title"] = L["Access denied"];
}

<div class="auth-form text-center">
    <div class="stat-icon tone-red mx-auto mb-3" style="width:64px;height:64px;font-size:1.8rem"><i class="bi bi-shield-lock"></i></div>
    <h1>@L["Access denied"]</h1>
    <p class="lead-sm">@L["You do not have permission to open this page."]</p>
    <a href="~/" class="btn btn-primary">@L["Go to my home"]</a>
</div>
