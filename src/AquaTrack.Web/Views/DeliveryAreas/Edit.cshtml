@model AreaFormViewModel
@{
    ViewData["Title"] = L["Edit area"];
}

<div class="page-head">
    <div>
        <a asp-action="Index" class="small fw-semibold text-decoration-none">
            <i class="bi @(AppCultures.IsUrdu ? "bi-arrow-right" : "bi-arrow-left")"></i> @L["Delivery areas"]
        </a>
        <h1 class="mt-1">@L["Edit area"]</h1>
    </div>
</div>

<div class="card" style="max-width:520px">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" data-once>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger flash validation-summary" role="alert"></div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name"></span>
            </div>
            <div class="mb-4">
                <label asp-for="DeliveryBoyId" class="form-label"></label>
                <select asp-for="DeliveryBoyId" class="form-select">
                    <option value="">@L["Not assigned"]</option>
                    @foreach (var s in Model.Staff)
                    {
                        <option value="@s.Id">@s.FullName</option>
                    }
                </select>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">@L["Save"]</button>
                <a asp-action="Index" class="btn btn-light">@L["Cancel"]</a>
            </div>
        </form>
    </div>
</div>
