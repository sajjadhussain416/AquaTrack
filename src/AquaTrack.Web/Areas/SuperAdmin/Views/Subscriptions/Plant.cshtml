@model PlantSubscription
@{
    ViewData["Title"] = Model.Name;
    var plans = (IReadOnlyList<PlanOption>)ViewBag.Plans;
    var today = (DateOnly)ViewBag.Today;
    int? daysLeft = Model.DueDate is null ? null
        : DateOnly.FromDateTime(PakistanTime.ToLocal(Model.DueDate.Value)).DayNumber - today.DayNumber;
    int Pct(int used, int? max) => max is null or 0 ? 0 : Math.Min(100, used * 100 / max.Value);
}

<div class="page-head">
    <div>
        <a asp-action="Index" class="back-link"><i class="bi @(AppCultures.IsUrdu ? "bi-arrow-right" : "bi-arrow-left")"></i>@L["Subscriptions"]</a>
        <h1>@Model.Name</h1>
        <p>@Model.OwnerName · <span class="num">@Model.Phone</span> · @Model.City</p>
    </div>
    <div class="actions">
        <a href="https://wa.me/@Fmt.WhatsAppNumber(Model.Phone)" target="_blank" rel="noopener" class="btn btn-light btn-icon text-success"><i class="bi bi-whatsapp"></i>WhatsApp</a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center"><i class="bi bi-credit-card-2-front me-2 text-primary"></i>@L["Subscription"]
                <span class="ms-auto"><partial name="_StatusBadge" model="Model.Status" /></span></div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-sm-4">
                        <div class="stat-label">@L["Plan"]</div>
                        <div class="fw-bold">@Model.PlanName</div>
                        <div class="cell-sub num">@Fmt.Money(Model.MonthlyPrice)/@L["month"]</div>
                    </div>
                    <div class="col-sm-4">
                        <div class="stat-label">@(Model.Status == PlantStatus.Trial ? L["Trial ends"] : L["Next due"])</div>
                        <partial name="_DueChip" model="(Model.DueDate, daysLeft, Model.Status)" />
                    </div>
                    <div class="col-sm-4">
                        <div class="stat-label">@L["Total paid"]</div>
                        <div class="fw-bold num">@Fmt.Money(Model.TotalPaid)</div>
                        <div class="cell-sub">@L["Since {0}", Fmt.Day(Model.CreatedAt)]</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="d-flex"><span class="stat-label">@L["Customers"]</span><span class="ms-auto num small fw-bold">@Model.Customers / @(Model.MaxCustomers?.ToString() ?? "∞")</span></div>
                        <div class="usage @(Model.MaxCustomers is not null && Model.Customers >= Model.MaxCustomers ? "full" : "")"><span style="width:@Pct(Model.Customers, Model.MaxCustomers)%"></span></div>
                    </div>
                    <div class="col-sm-6">
                        <div class="d-flex"><span class="stat-label">@L["Delivery staff"]</span><span class="ms-auto num small fw-bold">@Model.DeliveryStaff / @(Model.MaxDeliveryBoys?.ToString() ?? "∞")</span></div>
                        <div class="usage @(Model.MaxDeliveryBoys is not null && Model.DeliveryStaff >= Model.MaxDeliveryBoys ? "full" : "")"><span style="width:@Pct(Model.DeliveryStaff, Model.MaxDeliveryBoys)%"></span></div>
                    </div>
                </div>
            </div>
            <div class="card-body border-top d-flex flex-wrap gap-2">
                <form asp-action="ChangePlan" asp-route-id="@Model.Id" method="post" class="d-flex gap-2" data-once>
                    <select name="planId" class="form-select form-select-sm" style="width:auto;min-width:10rem">
                        @foreach (var p in plans)
                        {
                            <option value="@p.Id" selected="@(p.Id == Model.PlanId)">@p.Name · @Fmt.Money(p.MonthlyPrice)</option>
                        }
                    </select>
                    <button class="btn btn-light btn-sm text-nowrap">@L["Change plan"]</button>
                </form>
                @if (Model.Status == PlantStatus.Trial)
                {
                    <form asp-action="ExtendTrial" asp-route-id="@Model.Id" method="post" class="d-flex gap-2" data-once>
                        <select name="days" class="form-select form-select-sm" style="width:auto">
                            <option value="7">7 @L["days"]</option>
                            <option value="15">15 @L["days"]</option>
                            <option value="30">30 @L["days"]</option>
                        </select>
                        <button class="btn btn-light btn-sm text-nowrap">@L["Extend trial"]</button>
                    </form>
                }
                @if (Model.Status != PlantStatus.Suspended)
                {
                    <form asp-action="SetStatus" asp-route-id="@Model.Id" method="post" class="ms-auto" onsubmit="return confirm('@L["Suspend this plant? Its users will not be able to sign in."]');">
                        <input type="hidden" name="status" value="@PlantStatus.Suspended" />
                        <button class="btn btn-light btn-sm text-danger btn-icon"><i class="bi bi-pause-circle"></i>@L["Suspend"]</button>
                    </form>
                }
                else
                {
                    <form asp-action="SetStatus" asp-route-id="@Model.Id" method="post" class="ms-auto">
                        <input type="hidden" name="status" value="@PlantStatus.Active" />
                        <button class="btn btn-light btn-sm text-success btn-icon"><i class="bi bi-play-circle"></i>@L["Reactivate"]</button>
                    </form>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header"><i class="bi bi-cash-coin me-2 text-primary"></i>@L["Record payment"]</div>
            <form asp-action="RecordPayment" method="post" class="card-body d-grid gap-3" data-once>
                <input type="hidden" name="PlantId" value="@Model.Id" />
                <div class="row g-2">
                    <div class="col-5">
                        <label class="form-label small" for="Months">@L["Months"]</label>
                        <select id="Months" name="Months" class="form-select" data-months data-price="@Model.MonthlyPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                            @foreach (var m in new[] { 1, 3, 6, 12 })
                            {
                                <option value="@m">@m</option>
                            }
                        </select>
                    </div>
                    <div class="col-7">
                        <label class="form-label small" for="Amount">@L["Amount (PKR)"]</label>
                        <input id="Amount" name="Amount" type="number" min="1" step="1" required class="form-control num" value="@Model.MonthlyPrice.ToString("0", System.Globalization.CultureInfo.InvariantCulture)" data-amount />
                    </div>
                    <div class="col-5">
                        <label class="form-label small" for="PaidOn">@L["Paid on"]</label>
                        <input id="PaidOn" name="PaidOn" type="date" class="form-control num" value="@Fmt.Iso(today)" max="@Fmt.Iso(today)" required />
                    </div>
                    <div class="col-7">
                        <label class="form-label small" for="Note">@L["Note (optional)"]</label>
                        <input id="Note" name="Note" maxlength="300" class="form-control" placeholder="@L["e.g. Easypaisa TID"]" />
                    </div>
                </div>
                <p class="form-text m-0">@L["The plant becomes active and its next due date moves forward by the months paid."]</p>
                <button class="btn btn-primary btn-icon justify-content-center"><i class="bi bi-check2"></i>@L["Save payment"]</button>
            </form>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header"><i class="bi bi-clock-history me-2 text-primary"></i>@L["Payment history"]</div>
    @if (Model.Payments.Count == 0)
    {
        <div class="card-body text-muted small">@L["No subscription payments yet."]</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-at mb-0">
                <thead>
                    <tr>
                        <th>@L["Paid on"]</th>
                        <th class="text-end">@L["Amount"]</th>
                        <th>@L["Period"]</th>
                        <th>@L["Note"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @for (var i = 0; i < Model.Payments.Count; i++)
                {
                    var p = Model.Payments[i];
                    <tr>
                        <td class="num">@Fmt.Day(p.PaidOn)</td>
                        <td class="text-end num fw-bold">@Fmt.Money(p.Amount)</td>
                        <td class="num">@Fmt.Day(p.PeriodFrom) – @Fmt.Day(p.PeriodTo)</td>
                        <td class="text-muted">@p.Note</td>
                        <td class="text-end">
                            @if (i == 0)
                            {
                                <form asp-action="DeletePayment" asp-route-id="@p.Id" asp-route-plantId="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('@L["Remove this payment? The due date will move back."]');">
                                    <button class="btn btn-light btn-sm text-danger" aria-label="@L["Remove"]"><i class="bi bi-trash"></i></button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            var months = document.querySelector('[data-months]');
            var amount = document.querySelector('[data-amount]');
            if (!months || !amount) return;
            months.addEventListener('change', function () {
                amount.value = Math.round(parseFloat(months.dataset.price) * parseInt(months.value, 10));
            });
        })();
    </script>
}
